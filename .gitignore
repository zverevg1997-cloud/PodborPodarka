# Временные файлы сборки роликов: кадры, промежуточные склейки и готовые
# видео весят сотни мегабайт. В репозитории держим только исходники —
# скрипт сборки, тексты и тайминги.
video/frames*/
video/tmpframes/
video/build*/
video/audio*/
video/shots/
video/*.mp4

# Разовая проверка открытых адресов Wildberries
check-wb.mjs

# Готовые карточки пересобираются из cards/bg одной командой и весят
# тридцать мегабайт. Фоны остаются: они платные и каждый раз выходят разными.
cards/out/
