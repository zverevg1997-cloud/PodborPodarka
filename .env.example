# Подключение к базе данных PostgreSQL (Supabase).
# В Supabase: Project Settings → Database → Connection string → URI.
DATABASE_URL="postgresql://postgres:password@localhost:5432/daribot"

# Supabase Auth — используется для регистрации/входа по email+паролю.
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
# Secret key понадобится позже для серверных операций в обход RLS
# (например, административных скриптов). Держите его только на сервере.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"

# Ключ Anthropic для реального вызова Claude API в /api/recommend.
# Пока не используется — сейчас там заглушка mockRecommend().
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Секрет для подписи сессий/токенов (если потребуется помимо Supabase Auth).
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Пригодится позже для интеграции Telegram-входа.
TELEGRAM_BOT_TOKEN=""

# Партнёрская сеть Яндекс Маркета (CPA) — используется в /api/market-link,
# чтобы ссылки "Смотреть на Яндекс Маркете" в результатах подбора были
# реферальными. Без этих переменных ссылка ведёт на обычный (нетрекаемый)
# поиск на Маркете — сайт продолжает работать.
# Токен: кабинет партнёра (aff.market.yandex.ru) → иконка аккаунта →
# Настройки → API и модули → Токены авторизации → Создать новый токен.
YANDEX_MARKET_OAUTH_TOKEN=""
# CLID: кабинет партнёра → Продукты → Продукты, колонка CLID.
YANDEX_MARKET_CLID=""
