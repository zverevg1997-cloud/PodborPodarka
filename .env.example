# Подключение к базе данных PostgreSQL (Supabase).
# В Supabase: Project Settings → Database → Connection string → URI.
DATABASE_URL="postgresql://postgres:password@localhost:5432/daribot"

# Supabase Auth — используется для регистрации/входа по email+паролю.
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
# Secret key понадобится позже для серверных операций в обход RLS
# (например, административных скриптов). Держите его только на сервере.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"

# Каким ИИ подбирать идеи в /api/recommend: "yandex" или "claude".
# Если не задано — берётся тот провайдер, чьи ключи заполнены.
# Если ключей нет вовсе, локально работает заглушка mockRecommend(),
# а на проде /api/recommend отвечает 503.
AI_PROVIDER="yandex"

# YandexGPT через Яндекс AI Studio (OpenAI-совместимый эндпоинт).
# Ключ: консоль Яндекс Облака → сервисный аккаунт → создать API-ключ.
# Каталог: идентификатор folder в адресной строке консоли (b1g...).
YANDEX_API_KEY=""
YANDEX_FOLDER_ID=""
# Необязательно: полный URI модели, если нужна не та, что стоит по умолчанию
# в коде (gpt://<folder>/aliceai-llm/latest). В панели хостинга кавычки вокруг
# значения не ставьте — там они станут частью строки и сломают выбор модели.
YANDEX_MODEL=""

# Ключ Anthropic (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Необязательно: другая модель (по умолчанию claude-opus-5). Например claude-sonnet-5 — дешевле.
ANTHROPIC_MODEL=""

# Секрет для подписи сессий/токенов (если потребуется помимо Supabase Auth).
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Пригодится позже для интеграции Telegram-входа.
TELEGRAM_BOT_TOKEN=""

# Партнёрская сеть Яндекс Маркета (CPA) — используется в /api/market-link,
# чтобы ссылки "Смотреть на Яндекс Маркете" в результатах подбора были
# реферальными. Без этих переменных ссылка ведёт на обычный (нетрекаемый)
# поиск на Маркете — сайт продолжает работать.
# Токен: кабинет партнёра (aff.market.yandex.ru) → иконка аккаунта →
# Настройки → API и модули → Токены авторизации → Создать новый токен.
YANDEX_MARKET_OAUTH_TOKEN=""
# CLID: кабинет партнёра → Продукты → Продукты, колонка CLID.
YANDEX_MARKET_CLID=""

# Номер счётчика Яндекс Метрики. Без него счётчик не подключается —
# удобно для локальной разработки, чтобы не портить статистику.
NEXT_PUBLIC_METRIKA_ID=""
