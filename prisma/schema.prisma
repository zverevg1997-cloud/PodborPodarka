generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Аутентификация своя: пароль, сессии и коды подтверждения живут в этой же
// базе. Раньше за это отвечал Supabase Auth, но он хранил почты и пароли за
// пределами России, а 152-ФЗ требует обратного.
model User {
  id               String    @id @default(cuid())
  // Почты может не быть: во ВКонтакте аккаунт заводят на телефон, и адрес
  // он отдаёт не всегда. Уникальность при этом сохраняется — Postgres
  // считает пустые значения разными.
  email            String?   @unique
  phone            String?
  telegramId       String?   @unique
  // Кто вошёл через ВКонтакте. По нему узнаём человека при следующем входе.
  vkId             String?   @unique
  // Показываем в шапке вместо почты, когда почты нет.
  name             String?
  avatarUrl        String?
  // bcrypt. Хэши, перенесённые из Supabase, имеют формат $2a$ — библиотека
  // проверяет и их, и новые $2b$, поэтому пароли никому менять не пришлось.
  //
  // Пусто у тех, кто вошёл через ВКонтакте и пароля не заводил.
  passwordHash     String?
  // Пока пусто, войти нельзя: адрес не подтверждён.
  emailConfirmedAt DateTime?
  createdAt        DateTime  @default(now())

  profiles    Profile[]
  sessions    Session[]
  emailTokens EmailToken[]

  @@map("users")
}

// Сессия входа. В куке лежит случайный токен, здесь — его хэш: если база
// когда-нибудь утечёт, выданные сессии по ней не восстановить.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Код из письма: подтверждение почты и восстановление пароля.
// Хранится хэш — по той же причине, что и у сессий.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  // "confirm" — подтверждение почты, "reset" — восстановление пароля.
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  // Счётчик неверных попыток: после нескольких код перестаёт действовать,
  // иначе шестизначный код перебирается за минуты.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

// Профиль получателя подарка ("Мама", "Коллега Андрей" и т.п.).
// Принадлежит либо зарегистрированному пользователю, либо гостю: первый
// подбор доступен без регистрации, иначе человек упирается в форму раньше,
// чем понимает, зачем ему аккаунт.
model Profile {
  id           String   @id @default(cuid())
  userId       String?
  // Чат телеграма, если получателя завели через бота. Третий возможный
  // владелец профиля наряду с аккаунтом и гостем.
  telegramChat String?
  // Идентификатор из куки гостя. Заполнен, пока профиль не присвоен аккаунту.
  guestId      String?
  // IP на момент создания — нужен, чтобы очистка куки не давала гостю
  // бесконечные бесплатные подборы.
  guestIp      String?
  name         String
  gender       String?
  age          Int?
  relationship String?
  job          String?
  interests    String?
  createdAt    DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  searches Search[]

  @@index([userId])
  @@index([guestId])
  @@index([telegramChat])
  @@index([guestIp, createdAt])
  @@map("profiles")
}

// Один запрос на подбор подарка для конкретного профиля получателя.
model Search {
  id         String   @id @default(cuid())
  profileId  String
  occasion   String
  budget     String?
  timeframe  String?
  city       String?
  mood       String?
  resultJson Json?
  createdAt  DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("searches")
}

// Состояние диалога с ботом: на каком шаге человек и что уже ответил.
// Держим в базе, а не в памяти процесса: контейнер перезапускается при
// каждом деплое, и разговор оборвался бы на середине.
model TelegramChat {
  // Идентификатор чата в телеграме. Строкой: он не помещается в int32.
  id           String   @id
  // Откуда человек пришёл: метка из ссылки вида t.me/бот?start=vc.
  source       String?
  step         String   @default("idle")
  // Накопленные ответы: получатель, повод, бюджет, срок, город.
  draftJson    Json?
  // Последний подбор — чтобы кнопка «Ещё идеи» знала, что уже показано.
  lastSearchId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("telegram_chats")
}

// Замок на фоновые задачи, которые должен выполнять ровно один процесс.
// Нужен слушателю телеграма: при выкатке старый контейнер живёт рядом с
// новым, оба забирают сообщения и перебивают друг друга ошибкой Conflict.
// Клик по идее подарка — главное полезное действие сервиса: именно он
// приносит партнёрское вознаграждение. Считаем на сервере, а не в браузере:
// в боте нашего кода нет вовсе, а Метрика туда не дотягивается.
model LinkClick {
  id        String   @id @default(cuid())
  // Откуда пришёл клик: сайт, подборка или бот.
  source    String
  query     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
  @@map("link_clicks")
}

model SystemLock {
  id        String   @id
  // Кто держит замок — случайный идентификатор процесса. Нужен, чтобы
  // владелец мог продлевать аренду, а чужой процесс — нет.
  holder    String
  // Аренда, а не вечный замок: процесс может умереть, не отпустив его.
  expiresAt DateTime

  @@map("system_locks")
}

// Попытки регистрации с одного IP — нужны, чтобы ограничить массовое
// создание аккаунтов. В памяти процесса такой счётчик держать нельзя:
// запросы могут обслуживать разные инстансы, общего состояния у них нет.
model RegistrationAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  // Отдельный индекс для регулярной чистки старых записей.
  @@index([createdAt])
  @@map("registration_attempts")
}

// Запланированный пост в сообщество и канал.
//
// Тексты живут в коде (src/lib/social/plan.ts) и оттуда заливаются сюда по
// ключу. В базе хранится то, чего в коде быть не может: одобрение, картинка
// и отметка о публикации. Поэтому правка текста в коде не сбивает состояние,
// а перезапуск не публикует всё заново.
model ScheduledPost {
  id          String    @id @default(cuid())
  // Стабильный ключ из плана. По нему обновляем текст, не плодя дублей.
  key         String    @unique
  publishAt   DateTime
  // Что это: обычный пост, опрос или видео. Опросы и видео публикуются
  // руками — у них другой формат в каждой сети, и автоматизировать это
  // ради трёх записей не стоит.
  kind        String    @default("post")
  // Куда: "vk", "tg" или "both".
  networks    String
  textVk      String
  textTg      String
  // Нужна ли фотография товара. Пост с этой отметкой без картинки не уйдёт.
  needsPhoto  Boolean   @default(false)
  // file_id картинки в телеграме: администратор присылает её боту, а мы
  // потом скачиваем и перекладываем во ВКонтакте.
  photoFileId String?
  // draft → approved → published. Ещё бывает skipped, если пост отменили.
  status      String    @default("draft")
  vkPostId    String?
  tgMessageId String?
  publishedAt DateTime?
  // Почему не опубликовался. Показываем администратору, а не молчим.
  error       String?
  // Когда предупредили, что картинки нет. Нужна, чтобы напомнить один раз,
  // а не каждую минуту до самой публикации.
  warnedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishAt])
  @@map("scheduled_posts")
}
