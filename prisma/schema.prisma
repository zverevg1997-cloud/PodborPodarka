generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Аутентификация своя: пароль, сессии и коды подтверждения живут в этой же
// базе. Раньше за это отвечал Supabase Auth, но он хранил почты и пароли за
// пределами России, а 152-ФЗ требует обратного.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  phone            String?
  telegramId       String?   @unique
  // bcrypt. Хэши, перенесённые из Supabase, имеют формат $2a$ — библиотека
  // проверяет и их, и новые $2b$, поэтому пароли никому менять не пришлось.
  passwordHash     String
  // Пока пусто, войти нельзя: адрес не подтверждён.
  emailConfirmedAt DateTime?
  createdAt        DateTime  @default(now())

  profiles    Profile[]
  sessions    Session[]
  emailTokens EmailToken[]

  @@map("users")
}

// Сессия входа. В куке лежит случайный токен, здесь — его хэш: если база
// когда-нибудь утечёт, выданные сессии по ней не восстановить.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Код из письма: подтверждение почты и восстановление пароля.
// Хранится хэш — по той же причине, что и у сессий.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  // "confirm" — подтверждение почты, "reset" — восстановление пароля.
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  // Счётчик неверных попыток: после нескольких код перестаёт действовать,
  // иначе шестизначный код перебирается за минуты.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

// Профиль получателя подарка ("Мама", "Коллега Андрей" и т.п.).
// Принадлежит либо зарегистрированному пользователю, либо гостю: первый
// подбор доступен без регистрации, иначе человек упирается в форму раньше,
// чем понимает, зачем ему аккаунт.
model Profile {
  id           String   @id @default(cuid())
  userId       String?
  // Чат телеграма, если получателя завели через бота. Третий возможный
  // владелец профиля наряду с аккаунтом и гостем.
  telegramChat String?
  // Идентификатор из куки гостя. Заполнен, пока профиль не присвоен аккаунту.
  guestId      String?
  // IP на момент создания — нужен, чтобы очистка куки не давала гостю
  // бесконечные бесплатные подборы.
  guestIp      String?
  name         String
  gender       String?
  age          Int?
  relationship String?
  job          String?
  interests    String?
  createdAt    DateTime @default(now())

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  searches Search[]

  @@index([userId])
  @@index([guestId])
  @@index([telegramChat])
  @@index([guestIp, createdAt])
  @@map("profiles")
}

// Один запрос на подбор подарка для конкретного профиля получателя.
model Search {
  id         String   @id @default(cuid())
  profileId  String
  occasion   String
  budget     String?
  timeframe  String?
  city       String?
  mood       String?
  resultJson Json?
  createdAt  DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("searches")
}

// Состояние диалога с ботом: на каком шаге человек и что уже ответил.
// Держим в базе, а не в памяти процесса: контейнер перезапускается при
// каждом деплое, и разговор оборвался бы на середине.
model TelegramChat {
  // Идентификатор чата в телеграме. Строкой: он не помещается в int32.
  id           String   @id
  step         String   @default("idle")
  // Накопленные ответы: получатель, повод, бюджет, срок, город.
  draftJson    Json?
  // Последний подбор — чтобы кнопка «Ещё идеи» знала, что уже показано.
  lastSearchId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("telegram_chats")
}

// Попытки регистрации с одного IP — нужны, чтобы ограничить массовое
// создание аккаунтов. В памяти процесса такой счётчик держать нельзя:
// запросы могут обслуживать разные инстансы, общего состояния у них нет.
model RegistrationAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  // Отдельный индекс для регулярной чистки старых записей.
  @@index([createdAt])
  @@map("registration_attempts")
}
