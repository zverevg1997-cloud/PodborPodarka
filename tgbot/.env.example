# ===== Обязательно =====
# Токен бота от @BotFather (через него идут черновики и кнопки)
TELEGRAM_BOT_TOKEN=1234567890:AAAA-your-token
# Ключ Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Ваш числовой Telegram ID (узнать у @userinfobot)
ADMIN_ID=123456789

# ===== Telegram =====
# Ваш канал: @username или -1001234567890. Оставьте пустым, если публикуете только в ВК
TARGET_CHANNEL=@my_channel
# Публичные TG-каналы-источники через запятую (без t.me/)
SOURCE_CHANNELS=channel_one,channel_two

# ===== ВКонтакте =====
# Токен пользователя-администратора вашего сообщества (права wall, groups, offline) — для публикации
VK_TOKEN=vk1.a....
# ID вашего сообщества — только цифры, без минуса (из адреса club123456 → 123456)
VK_GROUP_ID=123456
# Сообщества-источники через запятую: короткие имена, ссылки или club123
VK_SOURCES=some_public,club987654,https://vk.com/another_public
# Сервисный ключ приложения для чтения источников (необязательно: если пусто, используется VK_TOKEN)
VK_READ_TOKEN=
# Что дописывать в конец постов только для ВК (например, хэштеги)
VK_SUFFIX=

# ===== Микс форматов постов =====
# Вес каждого формата в процентах (сумма не обязана давать ровно 100 — это просто пропорции).
# podborka — подборка из 2-4 товаров, single — разбор одного товара,
# engagement — вопрос к аудитории без товаров, seasonal — под ближайший повод/праздник,
# poll — нативный опрос (за один запуск делается максимум один опрос).
CONTENT_MIX=podborka:40,single:20,engagement:15,seasonal:15,poll:10

# ===== Необязательные настройки =====
CLAUDE_MODEL=claude-sonnet-5
DRAFTS_PER_RUN=3
RUN_EVERY_HOURS=6
MAX_SOURCE_POSTS=30
STYLE_FILE=style.txt
DB_PATH=bot.db
